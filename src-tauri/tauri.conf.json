{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTR Check list",
  "version": "1.0.0",
  "identifier": "com.nguyenfinn.mtrchecklist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost http://mtr.localhost mtr:; img-src 'self' data: http://mtr.localhost mtr:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
